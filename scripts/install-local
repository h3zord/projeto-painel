#!/usr/bin/env python3
"""Instala com segurança o bundle compilado Brain Panel.app no diretório de aplicações alvo.

Garantias:
1. Exige caminhos absolutos sem segmentos '..' e valida Info.plist + executável do bundle de origem.
2. Quando '--terminate-running' é informado, encerra de forma limpa (SIGTERM -> SIGKILL) instâncias em
   execução de '<dest-dir>/Brain Panel.app' e do provisório '<dest-dir>/AI Usage Menu.app'.
3. Copia para área de staging no mesmo diretório via '/usr/bin/ditto' e substitui '<dest-dir>/Brain Panel.app'
   com rollback automático se a troca falhar.
4. Remove seletivamente '<dest-dir>/AI Usage Menu.app' (se existir), preservando qualquer outro '.app' vizinho.
"""

from __future__ import annotations

import argparse
import errno
import os
import plistlib
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

EXPECTED_BUNDLE_ID = "com.h3zord.BrainPanel"
EXPECTED_EXECUTABLE_NAME = "Brain Panel"
TARGET_BUNDLE_NAME = "Brain Panel.app"
LEGACY_BUNDLE_NAME = "AI Usage Menu.app"
LEGACY_EXECUTABLE_NAME = "AI Usage Menu"


def validate_raw_absolute_path(raw: str, flag_name: str) -> Path:
    if not raw or "\0" in raw or not raw.startswith("/"):
        raise ValueError(f"{flag_name} exige caminho absoluto válido")
    segments = [seg for seg in raw.split("/") if seg]
    if ".." in segments:
        raise ValueError(f"{flag_name} não permite segmentos '..'")
    return Path(raw)


def validate_source_bundle(source_app: Path) -> None:
    if source_app.suffix != ".app":
        raise ValueError("bundle de origem deve terminar em '.app'")
    if source_app.is_symlink() or not source_app.is_dir():
        raise ValueError(f"bundle de origem inexistente ou inválido: {source_app}")

    info_plist_path = source_app / "Contents" / "Info.plist"
    executable_path = source_app / "Contents" / "MacOS" / EXPECTED_EXECUTABLE_NAME

    if not info_plist_path.is_file():
        raise ValueError(f"Info.plist ausente em {info_plist_path}")

    try:
        with info_plist_path.open("rb") as fp:
            plist_data = plistlib.load(fp)
    except Exception as exc:
        raise ValueError(f"Info.plist ilegível em {info_plist_path}: {exc}") from exc

    if not isinstance(plist_data, dict):
        raise ValueError("Info.plist inválido")

    bundle_id = plist_data.get("CFBundleIdentifier")
    if bundle_id != EXPECTED_BUNDLE_ID:
        raise ValueError(
            f"CFBundleIdentifier esperado '{EXPECTED_BUNDLE_ID}', obtido '{bundle_id}'"
        )

    bundle_exec = plist_data.get("CFBundleExecutable")
    if bundle_exec != EXPECTED_EXECUTABLE_NAME:
        raise ValueError(
            f"CFBundleExecutable esperado '{EXPECTED_EXECUTABLE_NAME}', obtido '{bundle_exec}'"
        )

    if not executable_path.is_file() or not os.access(executable_path, os.X_OK):
        raise ValueError(f"executável ausente ou sem permissão de execução: {executable_path}")


def command_matches_executable(command_line: str, exec_path: str) -> bool:
    return (
        command_line == exec_path
        or command_line.startswith(exec_path + " ")
        or command_line.endswith(" " + exec_path)
        or (" " + exec_path + " ") in command_line
    )


def find_matching_pids(executable_paths: set[str]) -> list[int]:
    if not executable_paths:
        return []
    proc = subprocess.run(
        ["/bin/ps", "-axo", "pid=,command="],
        capture_output=True,
        text=True,
        check=True,
    )
    ignored_pids = {os.getpid(), os.getppid()}
    matched: list[int] = []
    for raw_line in proc.stdout.splitlines():
        stripped = raw_line.strip()
        if not stripped:
            continue
        parts = stripped.split(None, 1)
        if len(parts) != 2:
            continue
        try:
            pid = int(parts[0])
        except ValueError:
            continue
        if pid <= 1 or pid in ignored_pids:
            continue
        cmd = parts[1]
        if any(command_matches_executable(cmd, target) for target in executable_paths):
            matched.append(pid)
    return matched


def is_pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError as exc:
        return exc.errno == errno.EPERM


def terminate_running_bundles(dest_dir: Path) -> None:
    candidate_executables = [
        dest_dir / TARGET_BUNDLE_NAME / "Contents" / "MacOS" / EXPECTED_EXECUTABLE_NAME,
        dest_dir / LEGACY_BUNDLE_NAME / "Contents" / "MacOS" / LEGACY_EXECUTABLE_NAME,
    ]
    target_paths: set[str] = set()
    for candidate in candidate_executables:
        target_paths.add(str(candidate))
        if candidate.exists():
            target_paths.add(str(candidate.resolve()))

    pids = find_matching_pids(target_paths)
    if not pids:
        return

    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue

    deadline = time.monotonic() + 3.0
    remaining = [pid for pid in pids if is_pid_alive(pid)]
    while remaining and time.monotonic() < deadline:
        time.sleep(0.05)
        remaining = [pid for pid in remaining if is_pid_alive(pid)]

    for pid in remaining:
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            continue


def install_bundle_atomically(source_app: Path, dest_dir: Path) -> Path:
    target_app = dest_dir / TARGET_BUNDLE_NAME
    staging_dir = Path(tempfile.mkdtemp(prefix=".BrainPanel-staging-", dir=str(dest_dir)))
    try:
        staged_app = staging_dir / TARGET_BUNDLE_NAME
        subprocess.run(
            ["/usr/bin/ditto", str(source_app), str(staged_app)],
            check=True,
        )
        validate_source_bundle(staged_app)

        if target_app.exists() or target_app.is_symlink():
            backup_app = staging_dir / "Brain Panel-previous.app"
            os.replace(target_app, backup_app)
            try:
                os.replace(staged_app, target_app)
            except Exception:
                if backup_app.exists() or backup_app.is_symlink():
                    os.replace(backup_app, target_app)
                raise
        else:
            os.replace(staged_app, target_app)
    finally:
        shutil.rmtree(staging_dir, ignore_errors=True)

    return target_app


def remove_legacy_bundle_if_present(dest_dir: Path) -> bool:
    legacy_app = dest_dir / LEGACY_BUNDLE_NAME
    if legacy_app.is_symlink():
        legacy_app.unlink()
        return True
    if legacy_app.exists():
        shutil.rmtree(legacy_app)
        return True
    return False


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Instala o Brain Panel.app validado no diretório de aplicações informado."
    )
    parser.add_argument(
        "--source-app",
        required=True,
        help="Caminho absoluto do bundle Brain Panel.app compilado.",
    )
    parser.add_argument(
        "--dest-dir",
        required=True,
        help="Caminho absoluto do diretório de destino (ex.: /Applications).",
    )
    parser.add_argument(
        "--terminate-running",
        action="store_true",
        help="Encerra instâncias em execução no destino antes de atualizar.",
    )
    parser.add_argument(
        "--open-app",
        action="store_true",
        help="Abre o Brain Panel.app instalado ao final.",
    )
    return parser.parse_args(argv)


def main(argv: list[str]) -> int:
    try:
        args = parse_args(argv)
        source_app = validate_raw_absolute_path(args.source_app, "--source-app")
        dest_dir = validate_raw_absolute_path(args.dest_dir, "--dest-dir")

        validate_source_bundle(source_app)
        if not dest_dir.is_dir():
            raise ValueError(f"diretório de destino inexistente: {dest_dir}")

        target_app = dest_dir / TARGET_BUNDLE_NAME
        if target_app.exists() and source_app.resolve() == target_app.resolve():
            raise ValueError("bundle de origem e destino apontam para o mesmo caminho")

        if args.terminate_running:
            terminate_running_bundles(dest_dir)

        installed_path = install_bundle_atomically(source_app, dest_dir)
        removed_legacy = remove_legacy_bundle_if_present(dest_dir)

        if args.open_app:
            subprocess.run(["/usr/bin/open", str(installed_path)], check=True)

        legacy_note = " (AI Usage Menu.app removido)" if removed_legacy else ""
        print(f"install-local: instalado em {installed_path}{legacy_note}")
        return 0
    except Exception as exc:
        print(f"install-local: erro: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
