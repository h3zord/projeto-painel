#!/usr/bin/env python3
"""Teste de mutação do domínio crítico do Brain Panel (10/11/2026, issue #2).

Copia o projeto para um workspace isolado em local/tmp/mutation-<pid> para nunca sujar a árvore git,
executa o controle sem mutação (exigindo 0 falhas) e aplica mutantes semânticos no domínio crítico.
Uma mutante só conta como morta quando o runner executa os testes e reporta falha real de asserção
('Executed N tests, with M failure' com M >= 1), nunca por erro de build nem por timeout.
"""

from __future__ import annotations

import os
import re
import shutil
import signal
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

MUTANT_TIMEOUT_SECONDS = 90
EXECUTED_RE = re.compile(r"Executed\s+(\d+)\s+tests?,\s+with\s+(\d+)\s+failures?")


@dataclass(frozen=True)
class MutantSpec:
    id: str
    relative_file: str
    description: str
    original: str
    replacement: str


