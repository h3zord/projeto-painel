# Configuração opcional do Brain Panel (validada de forma estrita no boot por Shared/Config/AppConfig.swift).
# Variáveis BRAIN_PANEL_* desconhecidas ou fora dos limites impedem a inicialização do processo.

# Modo de execução: live (padrão), isolated, self_check ou testing
BRAIN_PANEL_MODE=live

# Intervalo periódico de atualização das cotas em segundos (10..3600; padrão: 300)
BRAIN_PANEL_REFRESH_INTERVAL_SECONDS=300

# Idade máxima do cache ao abrir o painel em segundos (1..600; padrão: 60)
BRAIN_PANEL_CACHE_TTL_SECONDS=60

# URL local do painel web brain-pages (apenas http://127.0.0.1 ou http://localhost com porta opcional; padrão: http://127.0.0.1:4780/)
# BRAIN_PANEL_BRAIN_PAGES_URL=http://127.0.0.1:4780/

# Diretórios e arquivos opcionais (caminhos absolutos; no modo live usam os caminhos padrão do usuário quando omitidos)
# BRAIN_PANEL_CLAUDE_SESSIONS_DIR=/Users/exemplo/.claude/sessions
# BRAIN_PANEL_CLAUDE_PROJECTS_DIR=/Users/exemplo/.claude/projects
# BRAIN_PANEL_CLAUDE_CONTEXT_CACHE_DIR=/Users/exemplo/.cache/claude-context
# BRAIN_PANEL_ANTIGRAVITY_DIR=/Users/exemplo/.gemini/antigravity-cli
# BRAIN_PANEL_BRAIN_STATE_DIR=/Users/exemplo/.local/state
# BRAIN_PANEL_BRAIN_SESSIONS_STATE_DIR=/Users/exemplo/.local/state/brain-sessions
# BRAIN_PANEL_LOGS_DIR=/Users/exemplo/Library/Logs
# BRAIN_PANEL_LAUNCH_AGENTS_DIR=/Users/exemplo/Library/LaunchAgents
# BRAIN_PANEL_BACKUP_PROGRESS_FILE=/Users/exemplo/Brain/local/pages/backup-drive.json
# BRAIN_PANEL_APP_SUPPORT_DIR=/Users/exemplo/Library/Application Support/com.h3zord.BrainPanel
# BRAIN_PANEL_CLI_SEARCH_PATHS=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
